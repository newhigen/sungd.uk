---
interface Props {
  /** 현재 사이트 — 자기 자신은 목록에서 뺀다 */
  current?: 'home' | 'writing' | 'resume' | 'today';
}

const { current } = Astro.props;

const sites = [
  { id: 'home', mark: '⌂', name: 'home', href: 'https://sungd.uk', desc: '시작하는 곳' },
  { id: 'writing', mark: '¶', name: 'writing', href: 'https://writing.sungd.uk', desc: '책·생각·기술에 대해 쓴 글' },
  { id: 'resume', mark: '▤', name: 'resume', href: 'https://resume.sungd.uk', desc: '이력서와 만든 것들' },
  { id: 'ai', mark: '✦', name: 'ai', href: 'https://ai.sungd.uk', desc: 'Claude Code·Codex 릴리스에서 오늘 써볼 것' },
].filter(s => s.id !== current);
---

<ul class="site-links">
  {sites.map(s => (
    <li>
      <a href={s.href}>
        <span class="mark">{s.mark}</span>
        <span class="name">{s.name}</span>
        <span class="desc">{s.desc}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .site-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    max-width: 44rem;
  }
  .site-links a {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.5rem 0.5rem 0.5rem 0.25rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .site-links a:hover {
    background: var(--code-bg);
  }
  .mark {
    color: var(--text-tertiary);
    font-size: 0.875rem;
    width: 1rem;
    flex-shrink: 0;
  }
  .name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    flex-shrink: 0;
  }
  .desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    min-width: 0;
  }

  @media (max-width: 560px) {
    .site-links a {
      flex-wrap: wrap;
      row-gap: 0.125rem;
    }
    .desc {
      flex-basis: 100%;
      padding-left: 1.625rem;
    }
  }
</style>
