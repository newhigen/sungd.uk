---
// sungd.uk Main Landing Page
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="VLi2Q2MCHzrYvm80ry_lSLF1AueEC0iJDzkSxVWIqY8" />
  <meta name="description" content="조성덕 — ML Engineer @ VUNO. 직접 쓸 도구를 만들면서 일합니다." />
  <title>sungd.uk</title>
  <link rel="icon" type="image/png" href="/favicon-dark.png?v=4" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/png" href="/favicon-light.png?v=4" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/png" href="/favicon.png?v=4" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Nanum+Myeongjo:wght@400;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NM2EX11WS1"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    (function(){
      try {
        var m = new URLSearchParams(location.search).get('me');
        if (m === '1') document.cookie = 'sd_owner=1; domain=.sungd.uk; path=/; max-age=63072000; samesite=lax; secure';
        if (m === '0') document.cookie = 'sd_owner=; domain=.sungd.uk; path=/; max-age=0; samesite=lax; secure';
      } catch (e) {}
      window.__sdOwner = /(?:^|;\s*)sd_owner=1(?:;|$)/.test(document.cookie);
    })();
    gtag('set', 'user_properties', { visitor_type: window.__sdOwner ? 'owner' : 'visitor' });
    gtag('config', 'G-NM2EX11WS1');
    gtag('config', 'GT-KT4BFVVJ');
  </script>

  <style>
    @font-face {
      font-family: 'MaruBuri';
      src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_20-10-21@1.0/MaruBuri-Regular.woff') format('woff');
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'MaruBuri';
      src: url('https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_20-10-21@1.0/MaruBuri-SemiBold.woff') format('woff');
      font-weight: 600;
      font-display: swap;
    }

    :root {
      --bg: #fafafa;
      --text-primary: #18181b;
      --text-secondary: #52525b;
      --text-tertiary: #a1a1aa;
      --line: rgba(0, 0, 0, 0.07);
      --hover-bg: rgba(0, 0, 0, 0.035);
      --accent: #2563eb;
      
      --font-sans: "Plus Jakarta Sans", Pretendard, -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", sans-serif;
      --font-serif: "Nanum Myeongjo", serif;
      --font-mono: "JetBrains Mono", Menlo, monospace;
      color-scheme: light dark;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #090a0c;
        --text-primary: #f4f4f5;
        --text-secondary: #a1a1aa;
        --text-tertiary: #71717a;
        --line: rgba(255, 255, 255, 0.08);
        --hover-bg: rgba(255, 255, 255, 0.05);
        --accent: #60a5fa;
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      background: var(--bg);
      color: var(--text-primary);
      font-family: var(--font-sans);
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    /* Container: 단일 수직 축 */
    .page-wrap {
      width: 100%;
      max-width: 490px;
      min-height: 100vh;
      margin: 0 auto;
      padding: 56px 24px 80px;
    }

    /* Profile Header */
    .profile-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
    }
    .avatar {
      width: 60px;
      height: 60px;
      border-radius: 15px;
      object-fit: cover;
      border: 1px solid var(--line);
      background: var(--card-bg, #ffffff);
      flex-shrink: 0;
    }
    @media (prefers-color-scheme: dark) {
      .avatar {
        filter: invert(1) brightness(0.9);
      }
    }
    .meta {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .name-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .name-ko {
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--text-primary);
      line-height: 1.2;
    }
    .name-en {
      font-size: 0.9375rem;
      font-weight: 400;
      color: var(--text-tertiary);
    }
    .role-line {
      font-size: 0.84375rem;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 6px;
      letter-spacing: -0.01em;
    }

    /* Signature Tagline */
    .signature-tagline {
      font-family: var(--font-sans);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 30px;
      letter-spacing: -0.025em;
      line-height: 1.45;
    }

    /* Bio Section (Run-in Headings: Option C) */
    .bio-flow {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .bio-p {
      font-family: var(--font-serif);
      font-size: 0.9375rem;
      color: var(--text-secondary);
      line-height: 1.85;
      letter-spacing: -0.015em;
      word-break: keep-all;
    }
    .lead-bold {
      font-weight: 700;
      color: var(--text-primary);
    }
    .bio-p a {
      color: var(--text-primary);
      text-decoration: underline;
      text-decoration-color: var(--line);
      text-underline-offset: 3.5px;
      font-weight: 500;
      transition: all 0.15s ease;
    }
    .bio-p a:hover {
      color: var(--accent);
      text-decoration-color: var(--accent);
    }

    /* Epilogue (순수 여백형) */
    .epilogue-wrap {
      text-align: center;
      margin-top: 52px;
      margin-bottom: 24px;
      padding: 0 16px;
    }
    .epilogue-wrap .quote-text {
      font-family: var(--font-serif);
      font-size: 0.90625rem;
      color: var(--text-secondary);
      line-height: 1.8;
      word-break: keep-all;
      font-weight: 400;
    }
    .epilogue-wrap .quote-author {
      display: block;
      margin-top: 8px;
      font-family: var(--font-sans);
      font-size: 0.6875rem;
      color: var(--text-tertiary);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    /* Career & Education (완전 분리형) */
    .career-wrap {
      margin-top: 36px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .sec-heading {
      font-size: 0.75rem;
      font-family: var(--font-sans);
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--text-tertiary);
      margin-bottom: 12px;
    }
    .timeline {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    /* 학력 내부 항목 밀착: 8px */
    .edu-timeline {
      gap: 8px;
    }
    .timeline-entry {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .tl-main {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .tl-role-org {
      font-size: 0.9375rem;
      font-family: var(--font-sans);
      font-weight: 600;
      letter-spacing: -0.015em;
      color: var(--text-primary);
      line-height: 1.5;
    }
    .tl-role-org .org {
      color: var(--text-secondary);
      font-weight: 400;
    }
    .tl-date {
      font-size: 0.8125rem;
      color: var(--text-tertiary);
      font-family: var(--font-sans);
      letter-spacing: -0.01em;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    /* VUNO Teams Tree (점 없는 단정한 목록형) */
    .vuno-teams {
      list-style: none;
      margin-top: 6px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      border-left: 1.5px solid var(--line);
      padding-left: 14px;
      margin-left: 3px;
    }
    .vuno-team-item {
      font-size: 0.8125rem;
      display: flex;
      align-items: baseline;
      gap: 8px;
      line-height: 1.5;
      letter-spacing: -0.01em;
    }
    .vuno-team-name {
      font-weight: 600;
      color: var(--text-primary);
      font-family: var(--font-sans);
    }
    .vuno-team-product {
      color: var(--text-tertiary);
      font-family: var(--font-serif);
    }

    /* Footer (가로선 제거, 순수 여백 피날레) */
    footer {
      margin-top: 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .social-links {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .social-links a {
      color: var(--text-tertiary);
      transition: color 0.15s;
      display: inline-flex;
      align-items: center;
    }
    .social-links a:hover {
      color: var(--text-primary);
    }
    .social-icon {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }
    .footer-domain {
      font-size: 0.8125rem;
      color: var(--text-tertiary);
      font-family: var(--font-sans);
      font-weight: 500;
      letter-spacing: -0.01em;
      transition: color 0.15s;
    }
    .footer-domain:hover {
      color: var(--text-primary);
    }

    @media (max-width: 480px) {
      .page-wrap { padding: 40px 20px 60px; }
      .profile-header {
        gap: 14px;
        margin-bottom: 22px;
      }
      .avatar {
        width: 52px;
        height: 52px;
        border-radius: 13px;
      }
      .name-ko {
        font-size: 1.25rem;
      }
      .signature-tagline {
        font-size: 1.125rem;
        margin-bottom: 24px;
      }
      .tl-main {
        flex-wrap: wrap;
        gap: 2px 8px;
      }
      .epilogue-wrap {
        margin-top: 32px;
      }
    }
  </style>
</head>
<body>

  <div class="page-wrap">
    
    <!-- Profile Header -->
    <header class="profile-header">
      <img class="avatar" src="/avatar.jpg?v=3" alt="조성덕" />
      <div class="meta">
        <div class="name-row">
          <h1 class="name-ko">조성덕</h1>
          <span class="name-en">Sungduk Cho</span>
        </div>
        <div class="role-line">
          <span>ML Engineer @ VUNO</span>
        </div>
      </div>
    </header>

    <!-- 시그니처 앵커 -->
    <div class="signature-tagline">"직접 쓸 도구를 만들면서 일합니다."</div>

    <!-- Bio 3문단 (런인 헤드라인 C) -->
    <main>
      <div class="bio-flow">
        <p class="bio-p">
          <strong class="lead-bold">의료영상 AI를 연구하고 제품으로 만듭니다. </strong>
          뷰노에서 4년간 흉부 X-ray와 폐 CT 소견 모델을 개발하며, 여러 연구가 재사용하는 DB 기반 파이프라인과 자동 평가 체계를 세웠습니다. 
          단지 지표 몇 개를 높이는 것보다, 제품 관점에서 실제로 배포·최적화되고 팀이 반복 없이 안정적으로 실험할 수 있는 엔지니어링 기반을 다질 때 가장 큰 희열을 느낍니다. 
          업무 세부 내역과 전체 경력은 <a href="/cv/">이력서</a>에서 확인하실 수 있습니다.
        </p>

        <p class="bio-p">
          <strong class="lead-bold">내 생각과 인지 방식에 딱 맞춘 도구를 직접 깎아 씁니다. </strong>
          일상의 마찰을 줄이고 작업 속도를 증강(augment)하기 위해, 터미널 세션 모니터부터 개발 콘솔, AI 에이전트 작업 공간까지 삶과 일에 필요한 시스템을 직접 지어 씁니다. 
          단정한 도구와 시각적 질서가 생각의 속도를 높여준다고 믿습니다. 
          직접 만든 도구와 엔지니어링 노트는 <a href="https://dev.sungd.uk">dev.sungd.uk</a>에, 매일 써보는 최신 AI 도구 큐레이션은 <a href="https://ai.sungd.uk">ai.sungd.uk</a>에 기록합니다.
        </p>

        <p class="bio-p">
          <strong class="lead-bold">일하지 않을 때는 책을 읽고 사유하며 글을 남깁니다. </strong>
          인생을 어떻게 살고 일을 어떻게 해야 하는가에 대한 고민은 결국 엔지니어링과 맞닿아 있습니다. 
          책과 생각에 대해 쓴 글들은 <a href="https://writing.sungd.uk">writing.sungd.uk</a>에 남기고 있습니다. 
          함께 의미 있는 일을 즐겁게 해나갈 수 있는 동료로 기억되고 싶습니다.
        </p>
      </div>

      <!-- Career & Education -->
      <div class="career-wrap">
        <section class="sec-exp">
          <h2 class="sec-heading">경력</h2>
          <div class="timeline">
            <div class="timeline-entry">
              <div class="tl-main">
                <span class="tl-role-org">ML Engineer, <span class="org">뷰노 (VUNO)</span></span>
                <span class="tl-date">2022 – 현재</span>
              </div>
              <ul class="vuno-teams">
                <li class="vuno-team-item">
                  <span class="vuno-team-name">PXI (Chest) Team</span>
                  <span class="vuno-team-product">흉부 X-ray 진단 AI</span>
                </li>
                <li class="vuno-team-item">
                  <span class="vuno-team-name">BLU3 (Lung) Team</span>
                  <span class="vuno-team-product">폐 CT 진단 AI</span>
                </li>
                <li class="vuno-team-item">
                  <span class="vuno-team-name">Digital Oncology Team</span>
                  <span class="vuno-team-product">디지털 병리 R&D</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <section class="sec-edu">
          <h2 class="sec-heading">학력</h2>
          <div class="timeline edu-timeline">
            <div class="timeline-entry">
              <div class="tl-main">
                <span class="tl-role-org">고려대학교 <span class="org">컴퓨터과학 석사</span></span>
                <span class="tl-date">2020 – 2022</span>
              </div>
            </div>

            <div class="timeline-entry">
              <div class="tl-main">
                <span class="tl-role-org">울산과학기술원 (UNIST) <span class="org">컴퓨터공학 학사</span></span>
                <span class="tl-date">2015 – 2020</span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>

    <!-- Epilogue (순수 여백형) -->
    <div class="epilogue-wrap">
      <p class="quote-text">"어떤 점도 앞을 내다보며 연결할 수는 없다. 지난 점들은 오직 뒤를 돌아볼 때만 연결된다."</p>
      <span class="quote-author">— Steve Jobs</span>
    </div>

    <!-- Footer -->
    <footer>
      <div class="social-links">
        <a href="https://github.com/newhigen" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a href="https://linkedin.com/in/sungdukcho" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.65 1.65 0 0 0-1.66 1.66 1.66 1.66 0 0 0 1.66 1.66 1.66 1.66 0 0 0 1.66-1.66 1.65 1.65 0 0 0-1.66-1.66z"/>
          </svg>
        </a>
      </div>
      <span class="footer-domain">sungd.uk</span>
    </footer>

  </div>

</body>
</html>
